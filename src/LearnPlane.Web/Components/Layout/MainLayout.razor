@inherits LayoutComponentBase

<div class="app-shell">
    <button class="sidebar-backdrop @(_mobileMenuOpen ? "visible" : "")" aria-label="Lukk navigasjonsmenyen"
            tabindex="@(_mobileMenuOpen ? 0 : -1)" @onclick="CloseMobileMenu"></button>
    <aside id="main-navigation" class="sidebar @(_mobileMenuOpen ? "mobile-open" : "")">
        <div class="brand"><span class="brand-mark">LP</span><span>LearnPlane</span>
            <button class="mobile-menu-close" aria-label="Lukk meny" @onclick="CloseMobileMenu">×</button>
        </div>
        <AuthorizeView>
            <Authorized>
                <NavMenu OnNavigate="CloseMobileMenu" />
            </Authorized>
            <NotAuthorized>
                <p class="sidebar-intro">Lær i ditt tempo, fra 1. til 10. trinn.</p>
            </NotAuthorized>
        </AuthorizeView>
    </aside>
    <div class="page-column">
        <header class="topbar">
            <div class="mobile-nav-start">
                <button class="mobile-menu-button" aria-label="Åpne navigasjonsmenyen" aria-controls="main-navigation"
                        aria-expanded="@(_mobileMenuOpen ? "true" : "false")" @onclick="ToggleMobileMenu">
                    <span></span><span></span><span></span>
                </button>
                <span class="mobile-wordmark">LearnPlane</span>
            </div>
            <AuthorizeView>
                <Authorized Context="auth">
                    <span>Hei, @auth.User.Identity?.Name!</span>
                    <form method="post" action="/account/logout"><AntiforgeryToken /><button class="link-button" type="submit">Logg ut</button></form>
                </Authorized>
                <NotAuthorized>
                    <a href="/logg-inn">Logg inn</a>
                    <a class="button button-small" href="/registrer">Lag bruker</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>
        <main class="content">@Body</main>
        <footer>LearnPlane · Norsk læringsplattform basert på LK20</footer>
    </div>
</div>
<div id="blazor-error-ui">Noe gikk galt. <a href="." class="reload">Last inn på nytt</a></div>

@code {
    private bool _mobileMenuOpen;
    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMobileMenu() => _mobileMenuOpen = false;
}
