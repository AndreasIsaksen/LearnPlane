@page "/resultatliste"
@attribute [Authorize]
@inject IDbContextFactory<LearnPlaneDbContext> DbFactory

<PageTitle>Resultatliste – LearnPlane</PageTitle>
<div class="page-header"><div class="eyebrow">Felles framgang</div><h1>Resultatliste</h1><p>Beste quizresultat per kurs og beste spillresultat per nivå teller. Antall forsøk vises aldri.</p></div>

@if (_rows is null)
{
    <div class="loading">Regner ut plasseringer …</div>
}
else if (_rows.Count == 0)
{
    <div class="empty-state"><h2>Ingen resultater ennå</h2><p>Bestå en quiz eller et spillnivå for å bli den første på listen.</p></div>
}
else
{
    <div class="leaderboard">
        @for (var index = 0; index < _rows.Count; index++)
        {
            var row = _rows[index];
            <div class="leader-row @(index < 3 ? $"top-{index + 1}" : "")">
                <span class="rank">@(index + 1)</span>
                <span class="avatar">@Initials(row.Name)</span>
                <span class="leader-name"><strong>@row.Name</strong><small>@row.Courses quizzer · @row.GameLevels spillnivåer</small></span>
                <span><strong>@row.CorrectAnswers</strong><small>riktige valg</small></span>
                <span><strong>@row.Points</strong><small>poeng</small></span>
            </div>
        }
    </div>
}

@code {
    private List<LeaderRow>? _rows;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var quizAttempts = await db.QuizAttempts.AsNoTracking().Where(x => x.Passed)
            .Select(x => new { x.UserId, x.CourseId, x.CorrectAnswers, x.Percentage }).ToListAsync();
        var gameAttempts = await db.GameLevelAttempts.AsNoTracking().Where(x => x.Passed)
            .Select(x => new { x.UserId, x.GameLevelId, x.CorrectSelections, x.Percentage }).ToListAsync();
        var users = await db.Users.AsNoTracking().ToDictionaryAsync(x => x.Id, x => x.DisplayName);
        var bestQuiz = quizAttempts.GroupBy(x => new { x.UserId, x.CourseId })
            .Select(x => x.OrderByDescending(y => y.CorrectAnswers).ThenByDescending(y => y.Percentage).First()).ToList();
        var bestGame = gameAttempts.GroupBy(x => new { x.UserId, x.GameLevelId })
            .Select(x => x.OrderByDescending(y => y.CorrectSelections).ThenByDescending(y => y.Percentage).First()).ToList();
        var quizPoints = await db.QuizAttempts.AsNoTracking().GroupBy(x => x.UserId)
            .Select(x => new { UserId = x.Key, Points = x.Sum(y => y.PointsAwarded) }).ToDictionaryAsync(x => x.UserId, x => x.Points);
        var gamePoints = await db.GameLevelAttempts.AsNoTracking().GroupBy(x => x.UserId)
            .Select(x => new { UserId = x.Key, Points = x.Sum(y => y.PointsAwarded) }).ToDictionaryAsync(x => x.UserId, x => x.Points);
        var participatingUsers = bestQuiz.Select(x => x.UserId).Concat(bestGame.Select(x => x.UserId)).Distinct();
        _rows = participatingUsers.Select(userId => new LeaderRow(
                users.GetValueOrDefault(userId, "Ukjent"),
                bestQuiz.Where(x => x.UserId == userId).Sum(x => x.CorrectAnswers) + bestGame.Where(x => x.UserId == userId).Sum(x => x.CorrectSelections),
                quizPoints.GetValueOrDefault(userId) + gamePoints.GetValueOrDefault(userId),
                bestQuiz.Count(x => x.UserId == userId), bestGame.Count(x => x.UserId == userId)))
            .OrderByDescending(x => x.CorrectAnswers).ThenByDescending(x => x.Points).ThenBy(x => x.Name).ToList();
    }
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private sealed record LeaderRow(string Name, int CorrectAnswers, int Points, int Courses, int GameLevels);
}
