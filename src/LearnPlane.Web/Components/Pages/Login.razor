@page "/logg-inn"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Logg inn – LearnPlane</PageTitle>
<div class="auth-card">
    <div class="eyebrow">Velkommen tilbake</div>
    <h1>Logg inn</h1>
    <p>Fortsett læringen der du slapp.</p>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert error" role="alert">@Error</div>
    }
    <form method="post" action="/account/login" class="form-stack">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label>Brukernavn<input name="username" autocomplete="username" required autofocus /></label>
        <label>Passord<input name="password" type="password" autocomplete="current-password" required /></label>
        <button class="button" type="submit">Logg inn</button>
    </form>
    <p class="auth-switch">Ny her? <a href="/registrer">Lag din egen bruker</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "feil")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
