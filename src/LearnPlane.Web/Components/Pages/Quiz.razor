@page "/kurs/{Id:int}/quiz"
@attribute [Authorize]
@inject IDbContextFactory<LearnPlaneDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject QuizService QuizService

@if (_course is null)
{
    <div class="loading">Laster quiz …</div>
}
else if (_result is not null)
{
    <PageTitle>Resultat – LearnPlane</PageTitle>
    <section class="result-card @(_result.Score.Passed ? "passed" : "not-passed")">
        <div class="result-icon">@(_result.Score.Passed ? "✓" : "↻")</div>
        <div class="eyebrow">@(_result.Score.Passed ? "Bestått!" : "Nesten!")</div>
        <h1>@_result.Score.Percentage.ToString("0") % riktig</h1>
        <p>Du svarte riktig på @_result.Score.CorrectAnswers av @_result.Score.TotalQuestions spørsmål.</p>
        @if (!_result.CanEarnPoints) { <div class="alert info">Dette kurset er under ditt nåværende klassetrinn (@_result.CurrentGrade. klasse), så gjennomføringen gir ikke poeng.</div> }
        else if (_result.NewlyAwardedPoints > 0) { <div class="points-earned">+@_result.NewlyAwardedPoints poeng</div> }
        else if (_result.Score.Passed) { <p>Du har allerede fått alle poengene som dette resultatet kan gi. Få 100 % for å sikre hele potten på @_result.MaxPoints poeng.</p> }
        @if (_result.Lockout.IsLocked)
        {
            <div class="lockout-panel compact" role="alert"><span aria-hidden="true">⏳</span><div><strong>Quizen er midlertidig låst</strong><p>Tre feil innen 30 minutter gir en pause på 30 minutter. Omtrent @_result.Lockout.RemainingMinutes minutter gjenstår.</p></div></div>
        }
        <div class="button-row">
            @if (!_result.Lockout.IsLocked) { <button class="button secondary" @onclick="TryAgainAsync">Prøv igjen</button> }
            <a class="button" href="@($"/kurs/{Id}")">Til kurset</a>
        </div>
    </section>
    <section class="quiz-review" aria-labelledby="quiz-review-title">
        <div class="eyebrow">Lær av svarene</div>
        <h2 id="quiz-review-title">Faglig gjennomgang</h2>
        <p>Se hvorfor svaret er riktig før du prøver på nytt eller går videre.</p>
        @for (var index = 0; index < _questionOrder.Count; index++)
        {
            var question = _questionOrder[index];
            var selectedId = _answers.GetValueOrDefault(question.Id);
            var selected = question.Options.Single(x => x.Id == selectedId);
            var correct = question.Options.Single(x => x.IsCorrect);
            var answeredCorrectly = selected.Id == correct.Id;
            <article class="review-item @(answeredCorrectly ? "correct" : "incorrect")">
                <h3><span>@(answeredCorrectly ? "✓" : "→")</span> Spørsmål @(index + 1)</h3>
                <p class="review-question">@question.Text</p>
                <p><strong>Ditt svar:</strong> @selected.Text</p>
                @if (!answeredCorrectly)
                {
                    <p><strong>Riktig svar:</strong> @correct.Text</p>
                }
                <p class="review-explanation"><strong>Forklaring:</strong> @question.Explanation</p>
            </article>
        }
    </section>
}
else if (_lockout.IsLocked)
{
    <section class="lockout-panel" role="alert">
        <span class="lockout-icon" aria-hidden="true">⏳</span>
        <div>
            <div class="eyebrow">Læringspause</div>
            <h1>Denne quizen er låst en liten stund</h1>
            <p>Tre mislykkede forsøk innen 30 minutter utløser en 30-minutters pause. Bare denne quizen er låst; andre kurs, quizer og spill er fortsatt åpne.</p>
            <p><strong>Omtrent @_lockout.RemainingMinutes minutter gjenstår.</strong></p>
            <a class="button" href="@($"/kurs/{Id}")">Tilbake til kurset</a>
        </div>
    </section>
}
else
{
    <PageTitle>Quiz: @_course.Title – LearnPlane</PageTitle>
    <div class="quiz-header"><div class="eyebrow">@_course.Subject · @_course.Grade. klasse</div><h1>@_course.Title</h1><p>@QuizInstructions</p><div class="penalty-note"><span>⏱</span><span>@PenaltyText</span></div></div>
    <div class="quiz-questions">
        @for (var index = 0; index < _questionOrder.Count; index++)
        {
            var question = _questionOrder[index];
            <fieldset class="question-card">
                <legend><span>Spørsmål @(index + 1) av @_questionOrder.Count</span>@question.Text</legend>
                @foreach (var option in _optionOrder[question.Id])
                {
                    <label class="answer-option">
                        <input type="radio" name="@($"question-{question.Id}")" value="@option.Id"
                               checked="@(_answers.GetValueOrDefault(question.Id) == option.Id)"
                               @onchange="() => SelectAnswer(question.Id, option.Id)" />
                        <span>@option.Text</span>
                    </label>
                }
            </fieldset>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert error">@_error</div> }
    <button class="button submit-quiz" disabled="@_submitting" @onclick="SubmitAsync">@(_submitting ? "Ser på svarene …" : SubmitLabel)</button>
}

@code {
    [Parameter] public int Id { get; set; }
    private Course? _course;
    private readonly Dictionary<int, int> _answers = [];
    private List<QuizQuestion> _questionOrder = [];
    private Dictionary<int, List<AnswerOption>> _optionOrder = [];
    private QuizSubmission? _result;
    private ChallengeLockoutStatus _lockout = ChallengeLockoutStatus.Unlocked;
    private string? _userId;
    private string? _error;
    private bool _submitting;
    private bool IsEarlyGrade => _course is { Grade: <= 2 };
    private string QuizInstructions => IsEarlyGrade
        ? $"Velg ett svar på hvert av de {_questionOrder.Count} spørsmålene. Tenk på bildene, tingene du prøvde og ordene du øvde på. Spørsmål og svar får ny rekkefølge neste gang."
        : _course is { Grade: <= 4 }
            ? $"Svar på {_questionOrder.Count} spørsmål. Bruk modellene, eksemplene og fagordene. Spørsmål og svar stokkes for hvert forsøk."
            : $"Velg ett svar på hvert av {_questionOrder.Count} spørsmål. Rekkefølgen på både spørsmål og svar stokkes for hvert forsøk. 70 % gir bestått og ¾ av poengene; 100 % gir hele potten.";
    private string PenaltyText => IsEarlyGrade
        ? "Etter tre runder med under 70 % tar denne kunnskapsleken en pause på 30 minutter. Du kan fortsatt lære og spille andre steder."
        : "Tre mislykkede forsøk innen 30 minutter låser bare denne quizen i 30 minutter.";
    private string SubmitLabel => IsEarlyGrade ? "Se hvordan det gikk" : "Lever svar";

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _course = await db.Courses.AsNoTracking().Include(x => x.Questions).ThenInclude(x => x.Options)
            .SingleOrDefaultAsync(x => x.Id == Id && x.IsPublished);
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        _lockout = await QuizService.GetLockoutAsync(Id, _userId);
        ShuffleQuiz();
    }

    private void SelectAnswer(int questionId, int optionId) => _answers[questionId] = optionId;

    private async Task SubmitAsync()
    {
        if (_course is null) return;
        if (_answers.Count != _course.Questions.Count)
        {
            _error = "Svar på alle spørsmålene før du leverer.";
            return;
        }
        _submitting = true;
        try
        {
            _result = await QuizService.SubmitAsync(Id, _userId!, _answers);
            _lockout = _result.Lockout;
        }
        catch (ChallengeLockedException ex)
        {
            _lockout = ex.Lockout;
            _error = ex.Message;
        }
        finally { _submitting = false; }
    }

    private async Task TryAgainAsync()
    {
        _lockout = await QuizService.GetLockoutAsync(Id, _userId!);
        _answers.Clear();
        _result = null;
        _error = null;
        ShuffleQuiz();
    }

    private void ShuffleQuiz()
    {
        if (_course is null) return;
        _questionOrder = Shuffled(_course.Questions);
        _optionOrder = _course.Questions.ToDictionary(x => x.Id, x => Shuffled(x.Options));
    }

    private static List<T> Shuffled<T>(IEnumerable<T> source)
    {
        var values = source.ToList();
        for (var index = values.Count - 1; index > 0; index--)
        {
            var swapWith = Random.Shared.Next(index + 1);
            (values[index], values[swapWith]) = (values[swapWith], values[index]);
        }
        return values;
    }
}
